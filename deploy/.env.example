# ── YYC3-Baby-MoChen 运行配置（模板）────────────────────────────────
# 复制为 .env 后填写真实值；.env* 已被 .gitignore 覆盖，严禁提交入库。

# 应用监听端口（团队约定 3030 起；NAS 生产实测 3000/3100 被既有容器占用，采用 3030）
PORT=3030
NODE_ENV=production

# ── 数据库（必需）───────────────────────────────────────────────────
# mysql2 连接串；使用专用最小权限账号（开通见 deploy/README.md「数据库开通」）
DATABASE_URL='mysql://bgl:CHANGE_ME@127.0.0.1:3306/yyc3_baby_mochen'

# ── 登录鉴权（四选一；全不配则进入免登录回退模式）───────────────────
# ① kimi OAuth 平台：APP_ID / APP_SECRET / KIMI_AUTH_URL / KIMI_OPEN_URL
# ② 自建账号（推荐家庭自用）：AUTH_LOCAL_SECRET 设置即启用。
#    会话签名密钥 openssl rand -hex 32；账号用 scripts/user.mjs 发放，
#    登录页服务端渲染 /api/auth/local，会话 HttpOnly cookie（30 天）。
#    详见 ops/OPERATIONS.md §四。
#AUTH_LOCAL_SECRET=
# ③ 反向代理注入用户头：AUTH_HEADER_USER / AUTH_HEADER_NAME / AUTH_HEADER_EMAIL / AUTH_HEADER_FAMILY
# ④ Bearer JWT + JWKS 验签：AUTH_JWKS_URL / AUTH_SIGNIN_URL / AUTH_FAMILY_CLAIM
#AUTH_JWKS_URL=
#AUTH_SIGNIN_URL=

# ── 备份（backup.sh 读取；见 ops/OPERATIONS.md §五）────────────────
# 备份产出目录（默认 /var/backups/baby-mochen，NAS 生产用 /home/YYC3/backups/baby-mochen）
#BACKUP_DIR=/var/backups/baby-mochen
# 保留天数（默认 14）
#RETAIN_DAYS=14
# 异地备份（可选）：user@host:/path，需 SSH 免密
#BACKUP_REMOTE=
# mysqldump 全路径（fnOS/NAS 应用自装场景 PATH 里找不到时指定）
#MYSQLDUMP_BIN=/Volume2/@apps/mysql/mysql/bin/mysqldump

# ── 静态资源目录（可选；默认自动发现 dist-server 同级的 dist/）──────
#STATIC_DIR=/opt/baby-mochen/dist
