# ── YYC3-Baby-MoChen 运行配置（模板）────────────────────────────────
# 复制为 .env 后填写真实值；.env* 已被 .gitignore 覆盖，严禁提交入库。

# 应用监听端口（团队生产契约 3000）
PORT=3000
NODE_ENV=production

# ── 数据库（必需）───────────────────────────────────────────────────
# mysql2 连接串；使用专用最小权限账号（开通见 deploy/README.md「数据库开通」）
DATABASE_URL='mysql://bgl:CHANGE_ME@127.0.0.1:3306/yyc3_baby_mochen'

# ── 登录鉴权（三选一；全不配则进入免登录回退模式）───────────────────
# ① kimi OAuth 平台：APP_ID / APP_SECRET / KIMI_AUTH_URL / KIMI_OPEN_URL
# ② 反向代理注入用户头：AUTH_HEADER_USER / AUTH_HEADER_NAME / AUTH_HEADER_EMAIL / AUTH_HEADER_FAMILY
# ③ Bearer JWT + JWKS 验签：AUTH_JWKS_URL / AUTH_SIGNIN_URL / AUTH_FAMILY_CLAIM
#AUTH_JWKS_URL=
#AUTH_SIGNIN_URL=

# ── 静态资源目录（可选；默认自动发现 dist-server 同级的 dist/）──────
#STATIC_DIR=/opt/baby-mochen/dist
